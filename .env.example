# Local Postgres from docker-compose.yml. For Neon, paste its connection string here.
DATABASE_URL=postgres://scholarship:scholarship@localhost:5432/scholarship

# Admin sign-in (Auth.js). Generate the secret with `npx auth secret`.
# Create a GitHub OAuth app with callback URL http://localhost:3000/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Optional: comma-separated GitHub logins allowed into /admin (default: Abhiiiiijit)
# ADMIN_GITHUB_LOGINS=
